{{ 'customer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'order-history.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Filters */
  .oh-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .oh-filter {
    padding: 0.5rem 1.1rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    background: transparent;
    cursor: pointer;
    font-size: 0.875rem;
    font-family: inherit;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .oh-filter.active {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-foreground));
  }
  .oh-filter:hover:not(.active) {
    border-color: rgb(var(--color-foreground));
  }

  /* Order list */
  .oh-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 4px;
    overflow: hidden;
  }
  .oh-order {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }
  .oh-order:last-child {
    border-bottom: none;
  }

  /* Order header row — clickable */
  .oh-order__header {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    text-align: left;
    transition: background 0.15s;
  }
  .oh-order__header:hover {
    background: rgba(var(--color-foreground), 0.03);
  }
  .oh-order__primary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .oh-order__number {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .oh-order__secondary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: rgba(var(--color-foreground), 0.65);
  }
  .oh-order__total {
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin-left: auto;
  }
  .oh-chevron {
    font-size: 1.2rem;
    line-height: 1;
    transition: transform 0.2s ease;
    display: inline-block;
    color: rgba(var(--color-foreground), 0.4);
  }
  .oh-order__header[aria-expanded="true"] .oh-chevron {
    transform: rotate(90deg);
  }

  /* Desktop: single row layout */
  @media screen and (min-width: 750px) {
    .oh-order__header {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }
    .oh-order__primary {
      flex: 0 0 auto;
    }
    .oh-order__secondary {
      flex: 1;
      flex-wrap: nowrap;
      gap: 1.5rem;
    }
    .oh-order__total {
      margin-left: 0;
    }
  }

  /* Source badges */
  .oh-badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }
  .oh-badge--shopify { background: #e8f5e9; color: #2e7d32; }
  .oh-badge--pos     { background: #e3f2fd; color: #1565c0; }

  /* Line items panel */
  .oh-order__items {
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
    background: rgba(var(--color-foreground), 0.02);
    padding: 0.75rem 1rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  @media screen and (min-width: 750px) {
    .oh-order__items {
      padding: 0.75rem 1.25rem 1rem 2rem;
    }
  }

  /* Individual item */
  .oh-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.07);
    text-decoration: none;
    color: inherit;
  }
  .oh-item:last-child { border-bottom: none; }
  .oh-item:hover .oh-item__img { opacity: 0.8; }

  .oh-item__img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    display: block;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }
  .oh-item__img--placeholder {
    background: rgba(var(--color-foreground), 0.07);
  }
  .oh-item__details {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .oh-item__title {
    font-size: 0.9rem;
    font-weight: 500;
  }
  .oh-item__meta {
    font-size: 0.8rem;
    color: rgba(var(--color-foreground), 0.55);
  }

  /* Misc */
  .oh-loading { padding: 2rem 0; text-align: center; }
  .oh-error { padding: 1rem; background: #fff3f3; border: 1px solid #ffcdd2; border-radius: 4px; }
  .oh-empty { padding: 1rem 0; color: rgba(var(--color-foreground), 0.5); }

  /* Pagination */
  .oh-pagination {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .oh-page-btn {
    padding: 0.4rem 0.8rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.875rem;
  }
  .oh-page-btn--current {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-foreground));
  }
  .oh-page-btn:hover:not(.oh-page-btn--current) {
    border-color: rgb(var(--color-foreground));
  }
{%- endstyle -%}

<div class="customer account section-{{ section.id }}-padding">
  <div>
    <h1 class="customer__title">{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}">
      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 18 19">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M6 4.5a3 3 0 116 0 3 3 0 01-6 0zm3-4a4 4 0 100 8 4 4 0 000-8zm5.58 12.15c1.12.82 1.83 2.24 1.91 4.85H1.51c.08-2.6.79-4.03 1.9-4.85C4.66 11.75 6.5 11.5 9 11.5s4.35.26 5.58 1.15zM9 10.5c-2.5 0-4.65.24-6.17 1.35C1.27 12.98.5 14.93.5 18v.5h17V18c0-3.07-.77-5.02-2.33-6.15-1.52-1.1-3.67-1.35-6.17-1.35z" fill="currentColor">
      </svg>
      {{ 'customer.log_out' | t }}
    </a>
  </div>

  <div>
    <div>
      <h2>{{ 'customer.orders.title' | t }}</h2>

      {%- if customer -%}
        <order-history-list
          data-proxy-url="{{ section.settings.api_url | default: '/apps/order-history/orders' }}">
          <div class="order-history__loading" role="status">
            <p>Loading your order history...</p>
          </div>
        </order-history-list>
      {%- else -%}
        <p>{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    </div>

    <div>
      <h2>{{ 'customer.account.details' | t }}</h2>

      {{ customer.default_address | format_address }}

      <a href="{{ routes.account_addresses_url }}">
        {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
      </a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "Order Service API URL",
      "default": "/apps/order-history/orders",
      "info": "The URL to fetch unified order history from. Uses Shopify App Proxy path by default."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
