{{ 'customer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'order-history.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .order-history__filters {
    display: flex;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .order-history__filter-btn {
    padding: 0.5rem 1rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    background: transparent;
    cursor: pointer;
    font-size: 0.875rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .order-history__filter-btn.active {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-foreground));
  }

  .order-history__filter-btn:hover:not(.active) {
    border-color: rgb(var(--color-foreground));
  }

  .order-history__badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .order-history__badge--shopify {
    background: #e8f5e9;
    color: #2e7d32;
  }

  .order-history__badge--pos {
    background: #e3f2fd;
    color: #1565c0;
  }

  .order-history__items {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .order-history__item-img {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    display: block;
  }

  .order-history__item-img:hover {
    opacity: 0.85;
  }

  .order-history__item-name {
    font-size: 0.875rem;
  }

  .order-history__loading {
    padding: 2rem 0;
    text-align: center;
  }

  .order-history__error {
    padding: 1rem;
    background: #fff3f3;
    border: 1px solid #ffcdd2;
    border-radius: 4px;
  }

  .order-history__pagination {
    margin-top: 1.5rem;
  }

  .order-history__pagination ul {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .order-history__page-btn {
    padding: 0.4rem 0.8rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    background: transparent;
    cursor: pointer;
  }

  .order-history__page-btn:hover {
    border-color: rgb(var(--color-foreground));
  }
{%- endstyle -%}

<div class="customer account section-{{ section.id }}-padding">
  <div>
    <h1 class="customer__title">{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}">
      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 18 19">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M6 4.5a3 3 0 116 0 3 3 0 01-6 0zm3-4a4 4 0 100 8 4 4 0 000-8zm5.58 12.15c1.12.82 1.83 2.24 1.91 4.85H1.51c.08-2.6.79-4.03 1.9-4.85C4.66 11.75 6.5 11.5 9 11.5s4.35.26 5.58 1.15zM9 10.5c-2.5 0-4.65.24-6.17 1.35C1.27 12.98.5 14.93.5 18v.5h17V18c0-3.07-.77-5.02-2.33-6.15-1.52-1.1-3.67-1.35-6.17-1.35z" fill="currentColor">
      </svg>
      {{ 'customer.log_out' | t }}
    </a>
  </div>

  <div>
    <div>
      <h2>{{ 'customer.orders.title' | t }}</h2>

      {%- if customer -%}
        <order-history-list
          data-proxy-url="{{ section.settings.api_url | default: '/apps/order-history/orders' }}">
          <div class="order-history__loading" role="status">
            <p>Loading your order history...</p>
          </div>
        </order-history-list>
      {%- else -%}
        <p>{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    </div>

    <div>
      <h2>{{ 'customer.account.details' | t }}</h2>

      {{ customer.default_address | format_address }}

      <a href="{{ routes.account_addresses_url }}">
        {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
      </a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "Order Service API URL",
      "default": "/apps/order-history/orders",
      "info": "The URL to fetch unified order history from. Uses Shopify App Proxy path by default."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
